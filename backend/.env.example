# Sovereign AI Workbench - Production Configuration
# SIH 2026 Problem Statement 26117
# Mangalore Refinery and Petrochemicals Limited (MRPL)

# Core Application Settings
APP_NAME=Sovereign AI Workbench
APP_VERSION=1.0.0
DEBUG=false

# Air-Gapped Sovereignty and Network Security
AIR_GAPPED_MODE=true
ALLOWED_LOCAL_HOSTS=localhost,127.0.0.1,::1
ALLOWED_LOCAL_PORTS=11434,8000,8080,5173,3000

# Local AI Engine Settings (Zero Cloud Calls)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
MULTIMODAL_PROVIDER=ollama
VISION_MODEL=qwen3:8b
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Offline Hugging Face / Model Hub Protection
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1

# RBAC & Security Boundaries
ENFORCE_RBAC=true
DEFAULT_USER_ROLE=ENGINEER
AUDIT_SECRET_KEY=mrpl-air-gapped-cryptographic-audit-key-2026

# Document Vault Limits
MAX_DOCUMENT_SIZE_BYTES=52428800
MAX_IMAGE_SIZE_BYTES=10485760

# Production Documentation Exposure Toggle
ENABLE_DOCS=false

# Frontend CORS Allowed Origins
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

